# The product's ONE configuration surface (both modules + web; 12-factor, validated at startup
# with errors naming the offending setting). See packages/web/src/lib/server/config.ts.
# Webhook-era settings (peer URLs, signing secrets) no longer exist and are ignored if present.

# --- web ---------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# In production, the exact public browsing URL (SvelteKit form actions verify Origin against it):
#ORIGIN=

# --- web access control ------------------------------------------------------
# Both REQUIRED: startup fails without them (the gate never runs weakened or open).
# Signs session cookies; generate with e.g. `openssl rand -hex 32`. Rotating signs everyone out.
SESSION_SECRET=change-me
# Your Plex server's machineIdentifier: `curl http://<plex-host>:32400/identity`.
# Accounts whose Plex token can see this server are admitted; everyone else is denied.
PLEX_SERVER_MACHINE_ID=change-me
# plex.tv API base; only test tiers point this elsewhere.
#PLEX_API_BASE_URL=https://plex.tv/api/v2

# --- downloader module -------------------------------------------------------
# Where the downloader deposits a fulfilled release for the importer to collect. Formerly
# LIBRARY_ROOT, which is still honoured (with a startup warning) but must not disagree.
DEPOSIT_ROOT=/music/deposit
STAGING_ROOT=/music/staging
DOWNLOADER_DATABASE_FILE=data/downloader/events.db
SLSKD_BASE_URL=http://localhost:5030
SLSKD_API_KEY=change-me
#MUSICBRAINZ_BASE_URL=
#MUSICBRAINZ_USER_AGENT=
# Per-file kill budget for the ffprobe/decode validation passes:
#FFMPEG_TIMEOUT_MS=120000

# --- importer module ---------------------------------------------------------
INTAKE_ROOT=/music/intake
BEETS_CONFIG=/config/beets/config.yaml
IMPORTER_DATABASE_FILE=data/importer/events.db
#BRIDGE_PYTHON=python3
# Bundled deployments must point at the shipped bridge.py (the packaged default resolves
# beside the importer module, which bundling relocates):
#BRIDGE_SCRIPT=
#BRIDGE_TIMEOUT_MS=600000
#AUTO_APPLY_THRESHOLD=0.04
# The namespace delivered locations fall under; defaults to DEPOSIT_ROOT (deliveries are
# deposits under the downloader's deposit root), re-rooted onto INTAKE_ROOT at intake:
#INTAKE_SOURCE_ROOT=
