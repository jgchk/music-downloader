// The repo-root project: the build-tooling config files, which belong to no package's `include`.
// It must be named `tsconfig.json` — eslint's project service discovers projects by walking up for
// that exact filename, so a `tsconfig.config-files.json` would typecheck fine and still leave every
// config file a lint parse error. Files are named explicitly (not globbed) so a new one is a
// deliberate addition, and so this project claims nothing else on its way up the tree.
// `packages/web/vite.config.ts` and `eslint.config.js` are deliberately absent — the SvelteKit
// generated tsconfig and `test/boundaries/tsconfig.json` respectively already claim them, and a file
// claimed by two projects breaks eslint's project service.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": { "noEmit": true, "allowJs": true },
  "files": [
    "vitest.config.ts",
    "vitest.mutation.config.ts",
    "packages/downloader/vitest.config.ts",
    "packages/eventing/vitest.config.ts",
    "packages/importer/vitest.config.ts",
    "packages/web/playwright.config.ts",
    "packages/web/svelte.config.js",
    "packages/web/vitest.client.config.ts",
    "packages/web/vitest.server.config.ts",
    "packages/web/vitest.ssr.config.ts"
  ]
}
